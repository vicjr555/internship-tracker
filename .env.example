# Copy this file to .env for local development:  cp .env.example .env
# Never commit your real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# True locally, False in production.
DEBUG=True

# Comma-separated lists.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Leave unset locally to use SQLite. In production, e.g.:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=

# Shared secret for the POST /internal/sync/ endpoint (also a GitHub Actions secret).
SYNC_TOKEN=change-me-to-a-long-random-string

# Optional overrides (defaults shown).
# LISTINGS_SOURCE_URL=https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json
# LISTINGS_TERM=Summer 2027
